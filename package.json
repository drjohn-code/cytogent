{
  "name": "cytogent-web",
  "private": true,
  "description": "cytogent.com: Next.js App Router site (V3.1 build). The legacy static generator in source/ and its output in site/ are kept until cutover.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=chromium",
    "test:screens": "playwright test --project=screens",
    "seo:check": "playwright test --project=chromium --grep @seo",
    "check:code": "node scripts/code-check.mjs",
    "brand": "python3 scripts/build-mark.py && node scripts/build-wordmark.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "motion": "14.9.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "opentype.js": "1.3.4",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  }
}
